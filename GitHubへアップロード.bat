@echo off
chcp 65001 > nul
echo ======================================================
echo  GitHub (kaoriishige/akasawaonsen) へ送信しています...
echo ======================================================
cd /d "%~dp0"
git push -u origin main
echo.
if %ERRORLEVEL% equ 0 (
    echo ------------------------------------------------------
    echo  [成功] GitHubへのアップロードが完了しました！
    echo  この画面を閉じて、Netlifyの画面へお戻りください。
    echo ------------------------------------------------------
) else (
    echo ------------------------------------------------------
    echo  [エラーまたは認証中]
    echo  ブラウザ等でGitHubのログインが出た場合は許可してください。
    echo ------------------------------------------------------
)
echo.
echo キーボードの何かキーを押すとこの画面が閉じます。
pause > nul
